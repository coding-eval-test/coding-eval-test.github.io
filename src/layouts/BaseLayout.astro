---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const nav = [
  { href: '/scenarios/', label: 'Scenarios' },
  { href: '/getting-started/', label: 'Getting started' },
  { href: '/trainers/', label: 'For trainers' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="wrap">
        <nav>
          <a class="brand" href="/">Scenario Practice</a>
          {nav.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>
      </div>
    </header>

    <main id="main" class="wrap">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <p>
          Practice scenarios for enterprise-style coding interviews. Source on
          <a href="https://github.com/coding-eval-test">GitHub</a>.
        </p>
      </div>
    </footer>
  </body>
</html>
