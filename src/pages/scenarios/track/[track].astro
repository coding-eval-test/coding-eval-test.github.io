---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ScenarioCard from '../../../components/ScenarioCard.astro';
import { type Track } from '../../../tracks';
import { groupScenariosByTrack } from '../../../lib/scenarios';

export async function getStaticPaths() {
  const scenarios = await getCollection('scenarios', ({ data }) => data.published);
  return groupScenariosByTrack(scenarios).map(({ track, scenarios: trackScenarios }) => ({
    params: { track: track.id },
    props: { track, scenarios: trackScenarios },
  }));
}

interface Props {
  track: Track;
  scenarios: CollectionEntry<'scenarios'>[];
}

const { track, scenarios } = Astro.props;
---

<BaseLayout
  title={`${track.label} scenarios — Scenario Practice`}
  description={`${track.blurb} Scenario-based coding interview practice for the ${track.label} track.`}
>
  <h1>{track.label}</h1>
  <p class="prose">{track.blurb}</p>

  <ul class="card-grid">
    {scenarios.map((scenario) => <ScenarioCard scenario={scenario} />)}
  </ul>

  <p class="prose">
    <a href="/scenarios/">← All scenarios</a>
  </p>
</BaseLayout>
