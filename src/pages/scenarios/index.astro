---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ScenarioCard from '../../components/ScenarioCard.astro';
import { TRACKS } from '../../tracks';

const scenarios = await getCollection('scenarios', ({ data }) => data.published);

const sections = TRACKS.map((track) => ({
  track,
  scenarios: scenarios
    .filter((scenario) => scenario.data.track === track.id)
    .sort((a, b) => a.data.order - b.data.order),
})).filter((section) => section.scenarios.length > 0);
---

<BaseLayout
  title="Scenarios — Scenario Practice"
  description="Browse the available scenario-based coding interview practice exercises."
>
  <h1>Scenarios</h1>
  <p class="prose">
    Each scenario hands you a working codebase and a backlog. You extend it and
    fix it the way you would on a team, then push for automated feedback.
  </p>

  {
    sections.length === 0 ? (
      <p class="prose">
        <strong>No scenarios are published yet.</strong> The first one is being
        finished now — check back shortly.
      </p>
    ) : (
      sections.map(({ track, scenarios: trackScenarios }) => (
        <section class="track-section">
          <h2>
            <a href={`/scenarios/track/${track.id}/`}>{track.label}</a>
          </h2>
          <p class="prose track-blurb">{track.blurb}</p>
          <ul class="card-grid">
            {trackScenarios.map((scenario) => (
              <ScenarioCard scenario={scenario} />
            ))}
          </ul>
        </section>
      ))
    )
  }
</BaseLayout>

<style>
  .track-section {
    margin-top: var(--space-8);
  }

  .track-blurb {
    color: var(--color-text-muted);
    margin-top: 0;
  }
</style>
