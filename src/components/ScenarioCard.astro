---
import type { CollectionEntry } from 'astro:content';

interface Props {
  scenario: CollectionEntry<'scenarios'>;
}

const { scenario } = Astro.props;
const { data } = scenario;
const totalPoints =
  data.workItems.reduce((sum, item) => sum + item.points, 0) + data.regressionPoints;
const hours = (data.estimatedMinutes / 60).toFixed(1).replace(/\.0$/, '');
---

<li class="card">
  <h3><a href={`/scenarios/${data.id}/`}>{data.title}</a></h3>
  <p>{data.summary}</p>
  <p class="meta">
    <span class="tag">{data.difficulty}</span>
    <span class="tag">~{hours} h</span>
    <span class="tag">{data.workItems.length} work items</span>
    <span class="tag">{totalPoints} points</span>
  </p>
  <p class="stack">{data.stack.join(' · ')}</p>
</li>

<style>
  .card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    padding: var(--space-6);
  }

  .card h3 {
    margin-top: 0;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .stack {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin-bottom: 0;
  }
</style>
